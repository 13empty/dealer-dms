{
  "name": "dealer-dms",
  "productName": "Dealer DMS",
  "version": "1.0.12",
  "description": "Sistema local para talleres: órdenes de servicio, clientes, partes y caja",
  "author": "Dealer DMS",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "rebuild": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "smoke": "electron electron/smoke.cjs",
    "dist": "vite build && electron-builder --win nsis --publish never --config.win.signAndEditExecutable=false",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.39.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "wait-on": "^8.0.2"
  }
}
